@using SprintApp.Models

<div class="group relative flex flex-col bg-white rounded-3xl border border-amber-200/60 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
    <!-- Image Header -->
    <div class="relative h-52 w-full overflow-hidden bg-neutral-100">
        <img src="@Spot.ImageUrl" alt="@Spot.Name" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

        <!-- Badges & Favorite Button -->
        <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-1.5 items-center">
            <span class="px-3 py-1 rounded-full text-xs font-bold tracking-tight bg-white/95 backdrop-blur-md text-neutral-900 shadow-sm">
                @FormatCategory(Spot.Category)
            </span>
            @if (Spot.IsHighDemand)
            {
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500 text-white shadow-sm flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
                    High Demand
                </span>
            }
        </div>

        <button @onclick="() => OnToggleFavorite.InvokeAsync(Spot.Id)" 
                class="absolute top-3.5 right-3.5 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-sm shadow hover:scale-110 transition">
            @(IsFavorite ? "❤️" : "🤍")
        </button>

        <div class="absolute bottom-3 left-3.5 right-3.5 flex justify-between items-end text-white">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-black/50 backdrop-blur-md text-xs font-medium">
                ⏱ @Spot.SuggestedDuration
            </span>
            <div class="text-right">
                <span class="text-xs text-amber-300 font-bold block">@Spot.PriceTier</span>
                <span class="text-xl font-extrabold tracking-tight">₱@Spot.EstimatedPrice.ToString("N0")<span class="text-[10px] font-normal text-white/80">/pax</span></span>
            </div>
        </div>
    </div>

    <!-- Body -->
    <div class="p-5 flex flex-col flex-1 justify-between gap-4">
        <div class="space-y-2">
            <div class="flex items-start justify-between gap-2">
                <h3 class="text-lg font-black text-neutral-900 group-hover:text-amber-600 transition-colors">@Spot.Name</h3>
                <span class="flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-lg bg-amber-50 text-amber-800 border border-amber-200">
                    ★ @Spot.Rating
                </span>
            </div>
            <p class="text-xs font-semibold text-neutral-500 flex items-center gap-1">
                📍 @Spot.District • <span class="text-neutral-400 font-normal">(@Spot.ReviewCount reviews)</span>
            </p>
            <p class="text-xs text-neutral-600 leading-relaxed line-clamp-2">@Spot.Description</p>

            <!-- Traveler Review Snippet -->
            <div class="pt-2 border-t border-neutral-100 flex items-start gap-2.5 bg-neutral-50/80 p-2.5 rounded-2xl">
                <div class="w-6 h-6 rounded-full bg-amber-500 text-white font-black text-[10px] flex items-center justify-center flex-shrink-0">
                    @Spot.FeaturedReview.AvatarInitials
                </div>
                <div>
                    <span class="text-[10px] font-bold text-neutral-800">@Spot.FeaturedReview.ReviewerName</span>
                    <p class="text-[11px] text-neutral-500 italic leading-snug">“@Spot.FeaturedReview.Comment”</p>
                </div>
            </div>
        </div>

        <!-- Add Button -->
        <button @onclick="() => OnToggleTrail.InvokeAsync(Spot)" 
                disabled="@IsPinned"
                class="w-full py-3 px-4 rounded-2xl font-bold text-xs tracking-wide transition-all duration-200 flex items-center justify-center gap-2 @(IsPinned ? "bg-emerald-50 text-emerald-700 border border-emerald-300 cursor-default" : "bg-neutral-900 hover:bg-amber-600 text-white shadow hover:shadow-md active:scale-98")">
            @(IsPinned ? "✓ Added to Trail" : "+ Add to Trail")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FoodSpot Spot { get; set; } = default!;
    [Parameter] public bool IsPinned { get; set; }
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public EventCallback<FoodSpot> OnToggleTrail { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleFavorite { get; set; }

    private string FormatCategory(FoodCategory cat) => cat switch
    {
        FoodCategory.LightMeals => "Street & Light",
        FoodCategory.ComfortFood => "Comfort & BBQ",
        FoodCategory.FineDining => "Fine Dining",
        FoodCategory.LocalDelicacies => "Local Delicacy",
        _ => "General"
    };
}