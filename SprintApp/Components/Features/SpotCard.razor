@using SprintApp.Models
@using SprintApp.Services

@*
    Accessibility pattern: the title <button> is a "stretched link" (its ::after covers the whole card),
    so the entire card is clickable with ONE keyboard-focusable control. The favourite / trail / maps
    controls sit above it with relative z-10, which avoids nested interactive elements.
*@
<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-amber-200/60 bg-white shadow-sm transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-amber-300 hover:shadow-2xl hover:shadow-amber-900/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-amber-400 has-[:focus-visible]:ring-offset-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0">

    <!-- Media -->
    <div class="relative h-56 w-full overflow-hidden bg-neutral-100">
        <img src="@Spot.ImageUrl" alt="" loading="lazy"
             class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 motion-reduce:transform-none" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-black/30"></div>

        <!-- Badges -->
        <div class="absolute left-3.5 top-3.5 flex flex-wrap items-center gap-1.5">
            <CategoryBadge Category="Spot.Category" />
            @if (Spot.IsHighDemand)
            {
                <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/95 px-2.5 py-1 text-xs font-bold text-white shadow-sm">
                    <span class="relative flex h-1.5 w-1.5">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
                        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white"></span>
                    </span>
                    High Demand
                </span>
            }
        </div>

        <!-- Favourite -->
        <button type="button"
                @onclick="() => OnToggleFavorite.InvokeAsync(Spot.Id)"
                aria-pressed="@(IsFavorite ? "true" : "false")"
                aria-label="@(IsFavorite ? "Remove " + Spot.Name + " from favorites" : "Save " + Spot.Name + " to favorites")"
                class="absolute right-3.5 top-3.5 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 shadow backdrop-blur-md transition hover:scale-110 active:scale-95">
            <svg class="h-4 w-4 @(IsFavorite ? "animate-heart-pop fill-rose-500 text-rose-500" : "fill-none text-neutral-500")"
                 stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
        </button>

        <!-- Duration + price -->
        <div class="absolute bottom-3 left-3.5 right-3.5 flex items-end justify-between">
            <span class="inline-flex items-center gap-1 rounded-xl bg-black/50 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-md">
                <svg class="h-3.5 w-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                @Spot.SuggestedDuration
            </span>
            <PriceTag Tier="@Spot.PriceTier" Price="Spot.EstimatedPrice" />
        </div>
    </div>

    <!-- Body -->
    <div class="flex flex-1 flex-col gap-4 p-5">
        <div class="space-y-2.5">
            <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-black leading-snug text-neutral-900 transition-colors group-hover:text-amber-600">
                    <button type="button"
                            @onclick="() => OnSelectCard.InvokeAsync(Spot)"
                            aria-haspopup="dialog"
                            class="text-left after:absolute after:inset-0 after:content-[''] focus:outline-none">
                        @Spot.Name<span class="sr-only">, view details</span>
                    </button>
                </h3>
                <RatingPill Rating="Spot.Rating" ReviewCount="Spot.ReviewCount" />
            </div>

            <p class="flex items-center gap-1 text-xs font-semibold text-neutral-500">
                <svg class="h-3.5 w-3.5 flex-shrink-0 text-rose-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
                <span class="truncate">@Spot.District</span>
            </p>

            <p class="flex items-center gap-1.5 text-[11px] font-semibold text-amber-700">
                <StarIcon Class="h-3 w-3 flex-shrink-0 text-amber-500" />
                <span class="truncate">@Spot.StarQuality</span>
            </p>

            <p class="line-clamp-2 text-xs leading-relaxed text-neutral-600">@Spot.Description</p>

            <ReviewSnippet Review="Spot.FeaturedReview" Compact="true" />
        </div>

        <!-- Quick actions -->
        <div class="mt-auto flex items-center gap-2">
            <button type="button"
                    @onclick="() => OnToggleTrail.InvokeAsync(Spot)"
                    aria-pressed="@(IsPinned ? "true" : "false")"
                    class="relative z-10 flex flex-1 items-center justify-center gap-2 rounded-2xl px-4 py-3 text-xs font-bold tracking-wide transition-all duration-200 active:scale-[0.98] @(IsPinned ? "border border-emerald-300 bg-emerald-50 text-emerald-700 hover:bg-emerald-100" : "bg-neutral-900 text-white shadow hover:bg-amber-600 hover:shadow-lg")">
                @if (IsPinned)
                {
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                    <span>In Your Trail <span class="font-medium opacity-70">· tap to remove</span></span>
                }
                else
                {
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                    <span>Add to Trail</span>
                }
            </button>

            <a href="@MapsUrlBuilder.SearchUrl(Spot)"
               target="_blank" rel="noopener noreferrer"
               title="Open in Google Maps"
               aria-label="Open @Spot.Name in Google Maps (opens in a new tab)"
               class="relative z-10 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl border border-neutral-200 bg-white text-neutral-600 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-700 active:scale-95">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
            </a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public FoodSpot Spot { get; set; } = default!;
    [Parameter] public bool IsPinned { get; set; }
    [Parameter] public bool IsFavorite { get; set; }

    /// <summary>Toggles the spot in the trail (adds if absent, removes if present).</summary>
    [Parameter] public EventCallback<FoodSpot> OnToggleTrail { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleFavorite { get; set; }
    [Parameter] public EventCallback<FoodSpot> OnSelectCard { get; set; }
}
