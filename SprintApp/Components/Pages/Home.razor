@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SprintApp.Models
@using SprintApp.Services
@using SprintApp.Components.Features
@inject ITrailService Trail
@implements IDisposable

<div class="min-h-screen bg-[#FFFDF7] text-neutral-900 pb-20">
    <!-- Simulated Toast Notification -->
    @if (!string.IsNullOrEmpty(Trail.ActiveToastMessage))
    {
        <div class="fixed bottom-6 right-6 z-50 bg-neutral-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-neutral-700 animate-bounce">
            <span class="text-emerald-400 font-bold">✓</span>
            <span class="text-xs font-semibold">@Trail.ActiveToastMessage</span>
            <button @onclick="Trail.DismissToast" class="ml-2 text-neutral-400 hover:text-white text-xs">✕</button>
        </div>
    }

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-amber-100">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-amber-500 flex items-center justify-center text-white shadow-md text-xl">
                    🌊
                </div>
                <div>
                    <h1 class="text-lg font-black tracking-tight text-neutral-900 leading-none">Cebu Food Web</h1>
                    <p class="text-[11px] text-amber-700 font-semibold mt-0.5">Discover, Pin, and Devour Cebu’s Culinary Treasures</p>
                </div>
            </div>

            <!-- Links & CTA -->
            <div class="flex items-center gap-6">
                <nav class="hidden md:flex items-center gap-5 text-xs font-bold text-neutral-600">
                    <span class="text-amber-600 underline cursor-pointer">Culinary Trail</span>
                    <span class="hover:text-amber-600 cursor-pointer">Map Outlets</span>
                    <span class="hover:text-amber-600 cursor-pointer">Interactive Pass</span>
                    <span class="hover:text-amber-600 cursor-pointer">Reviews</span>
                </nav>
                <button @onclick="@(() => Trail.TriggerToast("Your Cebu trail has been saved."))"
                        class="px-4 py-2.5 rounded-2xl text-xs font-extrabold bg-amber-500 hover:bg-amber-600 text-white shadow transition">
                    Save Trail
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 pt-8 space-y-8">
        <!-- Hero Header -->
        <section class="space-y-3">
            <span class="text-xs font-extrabold uppercase tracking-widest text-amber-600">Your Personal Food Compass</span>
            <h2 class="text-3xl sm:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
                Plan your ultimate <span class="text-amber-500">Cebuano food trail</span>.
            </h2>
            <p class="text-sm text-neutral-500 max-w-2xl">
                Discover, pin, and devour Cebu's culinary treasures—from smoky roadside grills to the island's finest lechon.
            </p>
        </section>

        <!-- Live Trail Metrics Ribbon -->
        <section class="bg-white rounded-3xl border border-amber-200/80 p-5 shadow-sm grid grid-cols-1 sm:grid-cols-4 gap-4 items-center">
            <div class="sm:border-r border-neutral-100 pr-4">
                <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700">Live Trail Metrics</span>
                <p class="text-xs font-extrabold text-neutral-800 mt-0.5">Your Day At A Glance</p>
            </div>
            <div class="sm:border-r border-neutral-100 pr-4">
                <span class="text-[10px] font-bold text-neutral-400 uppercase">Total Estimated Budget</span>
                <p class="text-xl font-black text-amber-600">₱@Trail.GroupTotal.ToString("N0")</p>
            </div>
            <div class="sm:border-r border-neutral-100 pr-4">
                <span class="text-[10px] font-bold text-neutral-400 uppercase">Total Scheduled Stops</span>
                <p class="text-xl font-black text-neutral-900">@Trail.TotalStops Stops</p>
            </div>
            <div>
                <span class="text-[10px] font-bold text-neutral-400 uppercase">Est. Transit Time</span>
                <p class="text-xl font-black text-teal-600">~@Trail.TotalEstimatedMinutes mins</p>
            </div>
        </section>

        <!-- Filter & Search Controls -->
        <div class="flex flex-col lg:flex-row justify-between gap-4 items-stretch lg:items-center">
            <div class="flex flex-wrap gap-2">
                @foreach (FoodCategory cat in Enum.GetValues<FoodCategory>())
                {
                    <button @onclick="() => selectedCategory = cat" 
                            class="px-4 py-2.5 rounded-2xl text-xs font-bold transition @(selectedCategory == cat ? "bg-amber-500 text-white shadow-sm" : "bg-white text-neutral-700 border border-neutral-200 hover:bg-neutral-50")">
                        @GetCategoryLabel(cat)
                    </button>
                }
            </div>

            <div class="w-full lg:w-80">
                <input type="text"
                       placeholder="Search food spots, districts..."
                       @bind="searchQuery"
                       @bind:event="oninput"
                       class="w-full bg-white border border-neutral-200 rounded-2xl px-4 py-2.5 text-xs font-medium placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-sm" />
            </div>
        </div>

        <!-- View Switcher (Cards vs Route Map) -->
        <div class="flex justify-between items-center pt-2">
            <div>
                <h3 class="text-base font-extrabold text-neutral-900">Spot Finder</h3>
                <p class="text-xs text-neutral-400">Handpicked flavors from across the Queen City of the South.</p>
            </div>
            <div class="flex items-center gap-1 bg-neutral-100 p-1 rounded-2xl border border-neutral-200">
                <button @onclick="() => isMapView = false"
                        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(!isMapView ? "bg-white text-neutral-900 shadow-sm" : "text-neutral-500 hover:text-neutral-900")">
                    Cards View
                </button>
                <button @onclick="() => isMapView = true"
                        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(isMapView ? "bg-amber-500 text-white shadow-sm" : "text-neutral-500 hover:text-neutral-900")">
                    🗺 Route Map
                </button>
            </div>
        </div>

        <!-- Main Display Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <!-- Left Display: Cards or Route Map -->
            <div class="lg:col-span-2">
                @if (isMapView)
                {
                    <RouteMapView />
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        @if (!FilteredSpots.Any())
                        {
                            <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-dashed border-neutral-200 p-8">
                                <span class="text-3xl">🔍</span>
                                <h4 class="text-sm font-bold text-neutral-800 mt-2">No matching culinary stops</h4>
                                <p class="text-xs text-neutral-400 mt-1">Try resetting your filters or search query.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var spot in FilteredSpots)
                            {
                                <SpotCard Spot="spot" 
                                          IsPinned="Trail.IsSelected(spot.Id)" 
                                          IsFavorite="Trail.IsFavorite(spot.Id)"
                                          OnToggleTrail="Trail.AddStop" 
                                          OnToggleFavorite="Trail.ToggleFavorite" />
                            }
                        }
                    </div>
                }
            </div>

            <!-- Sticky Itinerary Sidebar -->
            <div class="lg:col-span-1">
                <TrailSidebar />
            </div>
        </div>
    </main>
</div>

@code {
    private string searchQuery = "";
    private FoodCategory selectedCategory = FoodCategory.All;
    private bool isMapView = false;

    protected override void OnInitialized() => Trail.OnChange += StateHasChanged;
    public void Dispose() => Trail.OnChange -= StateHasChanged;

    private IEnumerable<FoodSpot> FilteredSpots => Trail.Spots
        .Where(s => selectedCategory == FoodCategory.All || s.Category == selectedCategory)
        .Where(s => string.IsNullOrWhiteSpace(searchQuery) ||
                    s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.District.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private string GetCategoryLabel(FoodCategory cat) => cat switch
    {
        FoodCategory.All => "All Spots",
        FoodCategory.LightMeals => "🍢 Light Meals / Street Food",
        FoodCategory.ComfortFood => "🍲 Comfort Food / Sutukil",
        FoodCategory.FineDining => "🥂 Fine Dining",
        FoodCategory.LocalDelicacies => "🐖 Local Delicacies",
        _ => cat.ToString()
    };
}