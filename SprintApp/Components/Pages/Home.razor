@page "/"
@rendermode InteractiveServer
@using SprintApp.Models
@using SprintApp.Services
@using SprintApp.Components.UI
@using SprintApp.Components.Features
@inject ITrailService Trail
@implements IDisposable

<PageTitle>Cebu Food Web · Culinary Trail Planner</PageTitle>

<CebuRainCanvas />
<ToastHost />

<div class="relative z-10 pb-24">
    <HeroBanner SpotCount="Trail.Spots.Count" />

    <main id="main-content" tabindex="-1" class="relative mx-auto -mt-14 max-w-7xl space-y-8 px-6 focus:outline-none">
        @{ var spots = FilteredSpots.ToList(); }

        <TrailMetrics />

        <!-- Filters & search -->
        <section aria-label="Find food spots" class="flex flex-col items-stretch justify-between gap-4 lg:flex-row lg:items-center">
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
                @foreach (var cat in Enum.GetValues<FoodCategory>())
                {
                    var active = selectedCategory == cat;
                    <button type="button"
                            @onclick="() => selectedCategory = cat"
                            aria-pressed="@(active ? "true" : "false")"
                            class="inline-flex items-center gap-1.5 rounded-2xl px-4 py-2.5 text-xs font-bold transition duration-200 active:scale-95 @(active ? "bg-amber-500 text-white shadow-md shadow-amber-500/30" : "border border-neutral-200 bg-white/95 text-neutral-700 hover:border-amber-300 hover:bg-amber-50")">
                        <span aria-hidden="true">@cat.ToEmoji()</span>
                        @cat.ToLabel()
                    </button>
                }
            </div>

            <div class="relative w-full lg:w-80">
                <label for="spot-search" class="sr-only">Search food spots or districts</label>
                <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input id="spot-search"
                       type="text"
                       autocomplete="off"
                       placeholder="Search food spots, districts..."
                       @bind="searchQuery"
                       @bind:event="oninput"
                       class="w-full rounded-2xl border border-neutral-200 bg-white/95 py-2.5 pl-10 pr-10 text-xs font-medium placeholder-neutral-400 shadow-sm transition focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500" />
                @if (searchQuery.Length > 0)
                {
                    <button type="button" @onclick="() => searchQuery = string.Empty" aria-label="Clear search"
                            class="absolute right-2.5 top-1/2 flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-700">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                }
            </div>
        </section>

        <!-- View toggle -->
        <div class="flex flex-wrap items-end justify-between gap-3 pt-2">
            <div>
                <h2 class="font-display text-2xl font-black text-neutral-900">Spot Finder</h2>
                <p class="text-xs text-neutral-500" aria-live="polite">@ResultsSummary(spots.Count)</p>
            </div>

            <div class="inline-flex items-center gap-1 rounded-2xl border border-neutral-200 bg-white/80 p-1 backdrop-blur-md" role="group" aria-label="Choose view">
                @foreach (var (toMap, label, iconPath) in ViewModes)
                {
                    var selected = isMapView == toMap;
                    <button type="button"
                            @onclick="() => isMapView = toMap"
                            aria-pressed="@(selected ? "true" : "false")"
                            class="inline-flex items-center gap-1.5 rounded-xl px-3.5 py-1.5 text-xs font-bold transition duration-200 @(selected ? "bg-amber-500 text-white shadow-sm" : "text-neutral-500 hover:text-neutral-900")">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@iconPath" /></svg>
                        @label
                    </button>
                }
            </div>
        </div>

        <!-- Main layout -->
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-3">
            <div class="lg:col-span-2">
                @if (isMapView)
                {
                    <RouteMapView OnBrowse="() => isMapView = false" />
                }
                else if (spots.Count == 0)
                {
                    <div class="rounded-3xl border border-dashed border-neutral-200 bg-white/90 p-12 text-center">
                        <span class="mb-2 block text-4xl" aria-hidden="true">🔍</span>
                        <p class="text-sm font-bold text-neutral-800">No matching culinary stops</p>
                        <p class="mt-1 text-xs text-neutral-400">Try resetting your filters or search query.</p>
                        <button type="button" @onclick="ResetFilters"
                                class="mt-4 rounded-xl bg-neutral-900 px-4 py-2 text-xs font-bold text-white transition hover:bg-amber-600 active:scale-95">
                            Reset filters
                        </button>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        @for (var i = 0; i < spots.Count; i++)
                        {
                            var spot = spots[i];
                            <div @key="spot.Id"
                                 class="animate-pop-in motion-reduce:animate-none"
                                 style="animation-delay: @(i * 60)ms;">
                                <SpotCard Spot="spot"
                                          IsPinned="Trail.IsSelected(spot.Id)"
                                          IsFavorite="Trail.IsFavorite(spot.Id)"
                                          OnToggleTrail="ToggleStop"
                                          OnToggleFavorite="Trail.ToggleFavorite"
                                          OnSelectCard="OpenSpotModal" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="lg:col-span-1">
                <TrailSidebar />
            </div>
        </div>
    </main>

    <SpotDetailsModal Spot="inspectedSpot"
                      IsPinned="inspectedSpot is not null && Trail.IsSelected(inspectedSpot.Id)"
                      OnClose="() => inspectedSpot = null"
                      OnToggleTrail="ToggleStop" />
</div>

@code {
    private string searchQuery = string.Empty;
    private FoodCategory selectedCategory = FoodCategory.All;
    private bool isMapView;
    private FoodSpot? inspectedSpot;

    private static readonly (bool Map, string Label, string Icon)[] ViewModes =
    {
        (false, "Cards View", "M4 6h16M4 10h16M4 14h16M4 18h16"),
        (true, "Google Maps Route", "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7")
    };

    // Trail changes can originate on a background thread (toast timer) — marshal to the renderer.
    protected override void OnInitialized() => Trail.OnChange += HandleTrailChanged;
    private void HandleTrailChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Trail.OnChange -= HandleTrailChanged;

    private void OpenSpotModal(FoodSpot spot) => inspectedSpot = spot;

    private void ToggleStop(FoodSpot spot)
    {
        if (Trail.IsSelected(spot.Id))
        {
            Trail.RemoveStop(spot.Id);
            Trail.TriggerToast($"Removed {spot.Name} from your trail.");
        }
        else
        {
            Trail.AddStop(spot);
            Trail.TriggerToast($"Added {spot.Name} to your trail.");
        }
    }

    private void ResetFilters()
    {
        selectedCategory = FoodCategory.All;
        searchQuery = string.Empty;
    }

    private IEnumerable<FoodSpot> FilteredSpots => Trail.Spots
        .Where(s => selectedCategory == FoodCategory.All || s.Category == selectedCategory)
        .Where(s => string.IsNullOrWhiteSpace(searchQuery) ||
                    s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.District.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private string ResultsSummary(int shown) => isMapView
        ? $"{Trail.TotalStops} {(Trail.TotalStops == 1 ? "stop" : "stops")} chained into your route"
        : $"Showing {shown} of {Trail.Spots.Count} spots · open a card for menus, star qualities and reviews";
}
