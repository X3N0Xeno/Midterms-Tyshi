@using SprintApp.Models

<span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold tracking-tight shadow-sm @ToneClasses @Class">
    <span aria-hidden="true">@Category.ToEmoji()</span>
    @Category.ToLabel()
</span>

@code {
    [Parameter, EditorRequired] public FoodCategory Category { get; set; }

    /// <summary>Solid mango fill (modal) vs. frosted white (over photos).</summary>
    [Parameter] public bool Solid { get; set; }

    [Parameter] public string? Class { get; set; }

    private string ToneClasses => Solid
        ? "bg-amber-500 text-white"
        : "bg-white/90 text-neutral-900 backdrop-blur-md";
}
