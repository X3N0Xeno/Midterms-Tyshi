@inject IJSRuntime JS
@implements IAsyncDisposable

<canvas id="cebuRainCanvas" class="pointer-events-none fixed inset-0 z-0 h-full w-full" aria-hidden="true"></canvas>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initCebuCanvas");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("destroyCebuCanvas");
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }
}
