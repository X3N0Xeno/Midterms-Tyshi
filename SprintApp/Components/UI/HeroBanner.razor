<header class="relative isolate w-full overflow-hidden bg-neutral-950 px-6 pb-32 pt-20 sm:pt-24">
    @* Skyline photo, tinted and slightly oversized for a subtle parallax-free depth *@
    <div class="absolute inset-0 -z-10 scale-105 bg-cover bg-center opacity-40"
         style="background-image: url('https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?w=1600&auto=format&fit=crop&q=80');"
         aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-neutral-950/70 via-neutral-950/50 to-neutral-950" aria-hidden="true"></div>
    <div class="absolute -top-32 left-1/2 -z-10 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-amber-500/25 blur-3xl" aria-hidden="true"></div>
    @* Fades the hero into the cream page background so there is no hard seam *@
    <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-b from-transparent to-[#FFFDF7]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl space-y-6 text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-500/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-amber-300 backdrop-blur-md">
            <StarIcon Class="h-3.5 w-3.5 text-amber-400" />
            Queen City of the South • Culinary Pass
        </span>

        <h1 class="font-display text-5xl font-black uppercase leading-[0.95] tracking-tight drop-shadow-[0_4px_30px_rgba(245,158,11,0.35)] focus:outline-none sm:text-7xl lg:text-8xl">
            <span class="bg-gradient-to-br from-amber-200 via-amber-400 to-orange-500 bg-clip-text text-transparent">Cebu Food Web</span>
        </h1>

        <p class="mx-auto max-w-xl text-sm font-medium tracking-wide text-neutral-200 sm:text-base">
            Discover, Pin, and Devour Cebu’s Culinary Treasures
        </p>

        <ul class="flex flex-wrap items-center justify-center gap-2 pt-2 text-xs font-semibold text-neutral-100">
            <li class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 backdrop-blur-md">🍽️ @SpotCount handpicked spots</li>
            <li class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 backdrop-blur-md">🗺️ Live route planning</li>
            <li class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 backdrop-blur-md">💸 Per-pax budgets</li>
        </ul>
    </div>
</header>

@code {
    [Parameter] public int SpotCount { get; set; }
}
