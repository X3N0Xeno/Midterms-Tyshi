@using SprintApp.Models

@if (Spot != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto animate-fade-in">
        <div class="relative w-full max-w-2xl bg-white rounded-3xl border border-neutral-200 shadow-2xl overflow-hidden my-8" @onclick:stopPropagation>
            <!-- Header Image Banner -->
            <div class="relative h-64 w-full">
                <img src="@Spot.ImageUrl" alt="@Spot.Name" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                
                <button @onclick="OnClose" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/50 text-white flex items-center justify-center font-bold text-sm hover:bg-black/80 transition">
                    ✕
                </button>

                <div class="absolute bottom-4 left-6 right-6 text-white flex justify-between items-end">
                    <div>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500 text-white">
                            @Spot.Category
                        </span>
                        <h2 class="text-2xl font-black mt-1">@Spot.Name</h2>
                        <p class="text-xs text-neutral-300">📍 @Spot.District • @Spot.PriceTier</p>
                    </div>
                    <span class="text-2xl font-extrabold text-amber-400">₱@Spot.EstimatedPrice.ToString("N0")<span class="text-xs text-white/80 font-normal">/pax</span></span>
                </div>
            </div>

            <!-- Modal Content -->
            <div class="p-6 space-y-6">
                <!-- Star Quality Highlight -->
                <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 flex items-center gap-3">
                    <span class="p-2 rounded-xl bg-amber-500 text-white">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    </span>
                    <div>
                        <span class="text-[10px] font-black uppercase text-amber-800 tracking-wider">Star Quality Hallmark</span>
                        <p class="text-sm font-bold text-neutral-900">@Spot.StarQuality</p>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <h4 class="text-xs font-bold text-neutral-400 uppercase tracking-wider mb-1">About Venue</h4>
                    <p class="text-sm text-neutral-700 leading-relaxed">@Spot.Description</p>
                </div>

                <!-- Menu Highlights & Best Sellers -->
                <div>
                    <h4 class="text-xs font-bold text-neutral-400 uppercase tracking-wider mb-3">Menu Highlights & Best Sellers</h4>
                    <div class="space-y-2">
                        @foreach (var item in Spot.MenuHighlights)
                        {
                            <div class="flex items-center justify-between p-3 rounded-2xl bg-neutral-50 border border-neutral-100">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-xs text-neutral-900">@item.Name</span>
                                    @if (item.IsBestSeller)
                                    {
                                        <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 border border-rose-200">
                                            Best Seller
                                        </span>
                                    }
                                </div>
                                <span class="text-xs font-extrabold text-neutral-800">₱@item.Price.ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Traveler Review Section -->
                <div class="pt-2 border-t border-neutral-100">
                    <h4 class="text-xs font-bold text-neutral-400 uppercase tracking-wider mb-2">Verified Traveler Review</h4>
                    <div class="p-3.5 bg-neutral-50 rounded-2xl border border-neutral-100 flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-neutral-900 text-white font-black text-xs flex items-center justify-center flex-shrink-0">
                            @Spot.FeaturedReview.AvatarInitials
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-neutral-900">@Spot.FeaturedReview.ReviewerName</span>
                                <div class="flex text-amber-400 text-xs">
                                    @for (int i = 0; i < Spot.FeaturedReview.RatingStars; i++)
                                    {
                                        <span>★</span>
                                    }
                                </div>
                            </div>
                            <p class="text-xs text-neutral-600 mt-1 italic">“@Spot.FeaturedReview.Comment”</p>
                        </div>
                    </div>
                </div>

                <!-- Footer Action -->
                <div class="flex gap-3 pt-3">
                    <button @onclick="OnClose" class="flex-1 py-3 rounded-2xl text-xs font-bold bg-neutral-100 hover:bg-neutral-200 text-neutral-700 transition">
                        Back to Catalog
                    </button>
                    <button @onclick="() => OnToggleTrail.InvokeAsync(Spot)" 
                            class="flex-1 py-3 rounded-2xl text-xs font-bold bg-amber-500 hover:bg-amber-600 text-white shadow-md transition">
                        @(IsPinned ? "Remove from Trail" : "+ Add to Trail")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public FoodSpot? Spot { get; set; }
    [Parameter] public bool IsPinned { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FoodSpot> OnToggleTrail { get; set; }
}