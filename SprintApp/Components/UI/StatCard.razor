<div class="bg-white border-2 border-amber-100 rounded-2xl p-4 shadow-sm flex items-center gap-4">
    <div class="w-12 h-12 rounded-xl @BadgeColorClass flex items-center justify-center font-bold text-lg shadow-inner">
        @Icon
    </div>
    <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500">@Label</p>
        <p class="text-2xl font-black text-neutral-800">@Value</p>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "★";
    [Parameter] public string BadgeColorClass { get; set; } = "bg-amber-100 text-amber-700";
}