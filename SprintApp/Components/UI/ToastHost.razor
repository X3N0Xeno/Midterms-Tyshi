@using SprintApp.Services
@inject ITrailService Trail
@implements IDisposable

@* Always-mounted live region so screen readers announce toasts as they appear. *@
<div class="pointer-events-none fixed bottom-6 right-6 z-[60]" role="status" aria-live="polite">
    @if (!string.IsNullOrEmpty(Trail.ActiveToastMessage))
    {
        <div class="pointer-events-auto flex animate-toast-in items-center gap-3 rounded-2xl border border-white/10 bg-neutral-900/90 py-3 pl-4 pr-2 text-white shadow-2xl backdrop-blur-xl">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
            </span>
            <span class="text-xs font-semibold">@Trail.ActiveToastMessage</span>
            <button type="button"
                    @onclick="Trail.DismissToast"
                    aria-label="Dismiss notification"
                    class="flex h-7 w-7 items-center justify-center rounded-lg text-neutral-400 transition hover:bg-white/10 hover:text-white">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Trail.OnChange += HandleChange;

    // The toast timer fires on a thread-pool thread, so always marshal back to the renderer.
    private void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => Trail.OnChange -= HandleChange;
}
